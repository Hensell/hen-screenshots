!plugins/hen-screenshots/dist/
plugins/hen-screenshots/dist/*
!plugins/hen-screenshots/dist/cli.mjs
plugins/hen-screenshots/assets/*
!plugins/hen-screenshots/assets/icon.png
!plugins/hen-screenshots/assets/fonts/
plugins/hen-screenshots/assets/fonts/*
!plugins/hen-screenshots/assets/fonts/Manrope.ttf
!plugins/hen-screenshots/assets/fonts/Fraunces-Semibold.ttf
