# macOS
.DS_Store

# Dependencies and generated builds
node_modules/
dist/
coverage/
.vite/
.wrangler/
__pycache__/

# Local secrets and Cloudflare development bindings
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Local logs
*.log

# Local reference screenshots
references/screenshots/*
!references/screenshots/.gitkeep

# Personal project backups and exported compositions
*.henscreenshots
*.hentemplate
exports/

# Built local plugin packages
artifacts/
public/downloads/hen-screenshots-plugin-*.zip
public/downloads/hen-screenshots-plugin-*.zip.sha256

